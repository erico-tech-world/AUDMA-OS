# Optional external AI provider credentials. The default AI route is local Ollama.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE PROVIDER (neon | supabase | postgres_local | in_memory)
DB_PROVIDER="in_memory"
POSTGRES_DB="audma_os"
POSTGRES_USER="audma_app"
POSTGRES_PASSWORD="replace-with-a-local-development-password"
DATABASE_URL="postgresql://audma_app:replace-with-a-local-development-password@localhost:5432/audma_os"
PG_POOL_MAX="10"
PG_SSL="false"

# STORAGE PROVIDER (cloudflare_r2 | supabase_storage | minio | local)
STORAGE_PROVIDER="local"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME="audma-invoices"

# AI PROVIDER (gemini | groq | ollama | local_ocr)
AI_PROVIDER="ollama"
GROQ_API_KEY=""
OPENAI_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"

# QUEUE & EVENT BUS (bullmq | memory)
QUEUE_PROVIDER="memory"
REDIS_URL="redis://localhost:6379"

